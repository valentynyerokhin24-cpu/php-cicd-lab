@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false

actor Guest as guest
actor Customer as customer
actor Administrator as admin
actor "Payment Gateway" as payment
actor "Courier Service" as courier

customer --|> guest

rectangle "Computer Hardware Store" {
  usecase "Browse catalog" as UC_Browse
  usecase "Search products" as UC_Search
  usecase "Search by category" as UC_CategorySearch
  usecase "Search by brand" as UC_BrandSearch
  usecase "Register account" as UC_Register

  usecase "Manage cart" as UC_Cart
  usecase "Place order" as UC_Order
  usecase "Validate cart and stock" as UC_Validate
  usecase "Authorize payment" as UC_Pay
  usecase "Apply discount code" as UC_Discount
  usecase "View order history" as UC_History
  usecase "Request refund" as UC_Refund
  usecase "Track delivery" as UC_Track

  usecase "Maintain catalog" as UC_CatalogAdmin
  usecase "Manage orders" as UC_OrderAdmin
  usecase "View sales report" as UC_Report

  usecase "Refund transaction" as UC_RefundTransaction
  usecase "Query transaction status" as UC_PaymentStatus

  usecase "Create shipment" as UC_CreateShipment
  usecase "Track consignment" as UC_TrackConsignment
  usecase "Report delivery status" as UC_DeliveryStatus
}

guest --> UC_Browse
guest --> UC_Search
guest --> UC_Register
customer --> UC_Cart
customer --> UC_Order
customer --> UC_History
customer --> UC_Track
admin --> UC_CatalogAdmin
admin --> UC_OrderAdmin
admin --> UC_Report
payment --> UC_Pay
payment --> UC_RefundTransaction
payment --> UC_PaymentStatus
courier --> UC_CreateShipment
courier --> UC_TrackConsignment
courier --> UC_DeliveryStatus

UC_CategorySearch -|> UC_Search
UC_BrandSearch -|> UC_Search
UC_Order ..> UC_Validate : <<include>>
UC_Order ..> UC_Pay : <<include>>
UC_Discount ..> UC_Order : <<extend>>
UC_Refund ..> UC_History : <<extend>>
UC_Refund ..> UC_RefundTransaction : <<include>>
UC_Track ..> UC_TrackConsignment : <<include>>

@enduml
